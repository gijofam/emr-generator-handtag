import { useState } from 'react';
import { apiClient } from '../services/api';
import { getProductionPrintConfig } from '../services/calibrationStore';

export function BatchForm({ productId, onBatchGenerated }) {
  const [quantity, setQuantity] = useState(1);
  const [notes, setNotes] = useState('');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);

  async function handleSubmit(e) {
    e.preventDefault();
    if (!productId) {
      alert('Por favor selecciona un producto');
      return;
    }
    if (quantity < 1 || quantity > 1000) {
      alert('La cantidad debe estar entre 1 y 1000');
      return;
    }

    try {
      setLoading(true);
      setError(null);
      const printConfig = getProductionPrintConfig();
      const batchResult = await apiClient.generateBatch(productId, quantity, notes, printConfig);
      setResult(batchResult);
      setQuantity(1);
      setNotes('');
      onBatchGenerated?.(batchResult);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  async function handleDownload(downloadUrl) {
    try {
      const fileName = downloadUrl.split('/').pop();
      const blob = await apiClient.downloadFile(result.batchId, decodeURIComponent(fileName));
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      window.URL.revokeObjectURL(url);
      document.body.removeChild(a);
    } catch (err) {
      alert(`Error descargando: ${err.message}`);
    }
  }

  if (!productId) {
    return (
      <div className="section-card">
        <p className="info-message">Selecciona un producto para generar un lote</p>
      </div>
    );
  }

  return (
    <div className="section-card">
      <h2>Generar Lote de Handtags</h2>

      {result ? (
        <div className="batch-result">
          <div className="success-badge">✓ Lote generado exitosamente</div>
          <div className="result-details">
            <p><strong>ID Lote:</strong> {result.batchId}</p>
            <p><strong>Producto:</strong> {result.productName}</p>
            <p><strong>Cantidad:</strong> {result.quantity} códigos</p>
          </div>

          <h3>Descargas Disponibles</h3>
          <div className="download-list">
            {result.downloadFiles?.map(file => (
              <button
                key={file.name}
                className="download-item"
                onClick={() => handleDownload(file.downloadUrl)}
              >
                <span className="download-icon">⬇️</span>
                <span className="download-name">{file.name}</span>
                <span className="download-type">{file.type.toUpperCase()}</span>
              </button>
            ))}
          </div>

          <div className="codes-section">
            <h3>Códigos Generados</h3>
            <div className="codes-grid">
              {result.codes?.map(codeItem => (
                <div key={codeItem.code} className="code-card">
                  <div className="code-value">{codeItem.code}</div>
                  <a href={codeItem.qrUrl} target="_blank" rel="noopener noreferrer" className="qr-link">
                    Ver QR
                  </a>
                </div>
              ))}
            </div>
          </div>

          <button className="btn btn-secondary" onClick={() => setResult(null)}>
            Generar otro lote
          </button>
        </div>
      ) : (
        <form onSubmit={handleSubmit} className="batch-form">
          <div className="form-group">
            <label>Cantidad de Códigos</label>
            <input
              type="number"
              min="1"
              max="1000"
              value={quantity}
              onChange={e => setQuantity(Math.max(1, parseInt(e.target.value) || 1))}
              disabled={loading}
              required
            />
          </div>

          <div className="form-group">
            <label>Notas (Opcional)</label>
            <textarea
              value={notes}
              onChange={e => setNotes(e.target.value)}
              placeholder="Agregar notas sobre este lote..."
              disabled={loading}
              rows="3"
            />
          </div>

          {error && <div className="error-message">{error}</div>}

          <button type="submit" className="btn btn-primary" disabled={loading}>
            {loading ? 'Generando...' : 'Generar Lote'}
          </button>
        </form>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/services/api.js">
const API_BASE_URL = 'http://localhost:4000/api';
const BACKEND_BASE_URL = 'http://localhost:4000';

function fetchWithTimeout(url, options = {}, timeoutMs = 15000) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), timeoutMs);

  return fetch(url, {
    ...options,
    signal: controller.signal,
  }).finally(() => clearTimeout(timeout));
}

export const apiClient = {
  // Templates
  async getTemplateConfig() {
    const response = await fetchWithTimeout(`${API_BASE_URL}/templates`);
    if (!response.ok) throw new Error('Failed to fetch template config');
    return response.json();
  },

  async saveTemplateConfig({ frontTemplate, backTemplate }) {
    const response = await fetchWithTimeout(`${API_BASE_URL}/templates`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ frontTemplate, backTemplate }),
    });
    if (!response.ok) throw new Error('Failed to save template config');
    return response.json();
  },

  getActiveFrontTemplateUrl(cacheBuster = Date.now()) {
    return `${API_BASE_URL}/templates/front/active?t=${encodeURIComponent(String(cacheBuster))}`;
  },

  // Products
  async getProducts() {
    const response = await fetch(`${API_BASE_URL}/handtags/products`);
    if (!response.ok) throw new Error('Failed to fetch products');
    return response.json();
  },

  async createProduct(name, prefix) {
    const response = await fetch(`${API_BASE_URL}/handtags/products`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, prefix }),
    });
    if (!response.ok) throw new Error('Failed to create product');
    return response.json();
  },

  // Batches
  async generateBatch(productId, quantity, notes, printConfig = null) {
    const response = await fetch(`${API_BASE_URL}/handtags/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, quantity, notes, ...(printConfig ? { printConfig } : {}) }),
    });
    if (!response.ok) throw new Error('Failed to generate batch');
    return response.json();
  },

  async getBatches() {
    const response = await fetch(`${API_BASE_URL}/batches`);
    if (!response.ok) throw new Error('Failed to fetch batches');
    return response.json();
  },

  async getBatchFiles(batchId) {
    const response = await fetch(`${API_BASE_URL}/batches/${batchId}/files`);
    if (!response.ok) throw new Error('Failed to fetch batch files');
    return response.json();
  },

  async downloadFile(batchId, fileName) {
    const encodedFileName = encodeURIComponent(fileName);
    const response = await fetch(`${API_BASE_URL}/batches/${batchId}/download/${encodedFileName}`);
    if (!response.ok) throw new Error('Failed to download file');
    return response.blob();
  },

  async generateCalibrationPreview(printConfig) {
    console.log('[Trace][api.js] qrPlacement antes de POST /calibration/preview:', printConfig?.qrPlacement);
    const response = await fetchWithTimeout(`${API_BASE_URL}/calibration/preview`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ printConfig }),
    });
    if (!response.ok) throw new Error('Failed to generate calibration preview');
    return response.json();
  },

  async downloadPreviewFile(downloadUrl) {
    const url = downloadUrl.startsWith('http') ? downloadUrl : `${BACKEND_BASE_URL}${downloadUrl}`;
    const response = await fetchWithTimeout(url);
    if (!response.ok) throw new Error('Failed to download preview file');
    return response.blob();
  },
};
